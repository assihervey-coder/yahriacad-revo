// NEXUS PCB — Schéma de persistance
// Équivalent : PostgreSQL (métadonnées projets) + entrepôt des runs

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Projet de conception (une netlist + son historique)
model Project {
  id        String      @id @default(cuid())
  netlistId String      // identifiant de netlist (nexus-core, nexus-iot, nexus-rf)
  name      String
  createdAt DateTime    @default(now())
  runs      Run[]
  edits     EditEvent[]
}

/// Journal d'édition immuable [P2.4] — traçabilité des gestes d'édition
/// (multi-utilisateurs prêt : actor distinguera les auteurs sur Postgres)
model EditEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor     String   @default("local") // auteur du geste (session multi-user à venir)
  kind      String   // move | nudge-live | drag | undo | redo
  ref       String   // designateur du composant
  xFrom     Float
  yFrom     Float
  xTo       Float
  yTo       Float
  rotFrom   Int?
  rotTo     Int?
  meta      String?  // détail libre (ex: « flux live coupé puis repris »)
  createdAt DateTime @default(now())
}

/// Utilisateur applicatif [Sprint 2 — M4] — authentification + rôles.
/// role = "admin" | "ingenieur" | "lecteur" (String porté par l'app :
/// Prisma n'accepte pas les enums sur SQLite — la réversibilité provider
/// de M3 doit être préservée ; la validation du rôle est faite dans
/// src/lib/auth.ts).
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  role      String   @default("lecteur")
  createdAt DateTime @default(now())
}

/// Exécution du pipeline de conception autonome
model Run {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status         String   // success | partial | error
  planSource     String   // llm | rules
  costHpwl       Float
  costThermal    Float
  costConstraint Float
  routedNets     Int
  totalNets      Int
  viaCount       Int
  totalLengthMm  Float
  drcErrors      Int
  drcWarnings    Int
  dfmScore       Int
  maxTempC       Float
  durationMs     Int
  createdAt      DateTime @default(now())
}
